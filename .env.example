# Names only. Put real values in your MCP client's env block or in a chmod 600 file passed
# with --env-file. The server never searches for .env files on its own.

# --- CRM server (servers/crm/server.py) -------------------------------------------
# Base URL of Supabase (https://<project>.supabase.co) or of a plain PostgREST
CRM_SUPABASE_URL=
# REST path prefix: /rest/v1 for Supabase (default), empty for plain PostgREST
CRM_REST_PATH=
# Public API key sent as `apikey` (Supabase anon key). Defaults to CRM_AGENT_TOKEN.
CRM_API_KEY=
# JWT for the restricted crm_agent role (never service_role). See scripts/mint_agent_jwt.py
CRM_AGENT_TOKEN=
# off (default) | dry_run | on
CRM_WRITE_MODE=
# Max writes per server process (default 20)
CRM_MAX_WRITES=
# HTTP timeout in seconds (default 15)
CRM_TIMEOUT_SECONDS=
# Table names (defaults: prospectos, prospecto_notas, prospecto_cambios)
CRM_TABLE_PROSPECTOS=
CRM_TABLE_NOTAS=
CRM_TABLE_CAMBIOS=
# debug | info (default) | warning | error
CRM_LOG_LEVEL=

# --- Optional read-only GoHighLevel adapter (servers/ghl_readonly/server.py) --------
GHL_URL=
GHL_TOKEN=
GHL_LOCATION_ID=
# 1 = serve synthetic fixtures, no network and no token
GHL_MOCK=

# --- Monitoring (scripts/healthcheck-alert.sh) ---------------------------------------
CRM_ENV_FILE=
ALERT_WEBHOOK_URL=
